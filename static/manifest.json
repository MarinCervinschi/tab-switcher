{
	"manifest_version": 3,
	"name": "Tab Switcher",
	"version": "0.1.0",
	"description": "Ctrl+Tab in most-recently-used order, with a list of your tabs while you hold Ctrl.",
	"minimum_chrome_version": "121",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"key": "",
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["tabs", "storage", "scripting", "favicon"],
	"host_permissions": ["<all_urls>"],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_origin_as_fallback": true
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["_favicon/*"],
			"matches": ["<all_urls>"]
		}
	],
	"commands": {
		"next": {
			"description": "Next tab, most recently used first"
		},
		"previous": {
			"description": "Previous tab, most recently used first"
		}
	}
}
