{
	"include": ["src/**/*.ts", "*.config.ts"],
	"exclude": ["node_modules", "dist"],
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["chrome"],
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	}
}
